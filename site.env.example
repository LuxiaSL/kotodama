# Site profile: copy to site.env (gitignored) and edit for this machine.
# Sourced by tools/_env.sh before every launcher. Everything is optional;
# the defaults keep the whole install inside the repo directory.
# tools/site_check.sh verifies the profile as the launchers see it.

# Python environment with torch + the packages in pyproject.toml.
# export KOTODAMA_VENV=/path/to/venv

# Where training data (.bin token streams), NCA data and checkpoints live.
# export KOTODAMA_DATA_ROOT=/data/kotodama

# Persistent torch.compile / Triton caches (put them on a roomy disk).
# export KOTODAMA_CACHE_ROOT=/data/kotodama/.compile-cache
# Compiled serve-engine artifacts shared by every server on this machine (kotodama.serve.compile_cache): a server
# loads its key's blob before compiling and saves one after warmup. Unset = off.
# export KOTODAMA_COMPILE_STORE=/data/kotodama/compile-store

# Python headers for Triton/Inductor builds, if the system lacks them.
# export KOTODAMA_CPATH=/path/to/python3.12-include

# If your job scheduler exports the job id under its own variable name,
# name that variable here; train.py then reports metrics against it.
# export KOTODAMA_SCHEDULER_JOB_ID_VAR=SLURM_JOB_ID
# export KOTODAMA_SCHEDULER_URL=http://127.0.0.1:7000

# Uncheatable Eval data for kotodama.eval.uncheatable: <domain>.json[l] files,
# the release's .parquet, or its HF snapshot dir (default: the HF dataset id).
# export KOTODAMA_UNCHEATABLE_DATA=/data/uncheatable-eval-2026-04

# Frozen prompt files for the binding benchmark's suite (python -m kotodama.eval.binding; one dir, each file
# sha256-pinned by the benchmark).
# export KOTODAMA_BINDING_PROMPTS=/data/binding-prompts

# The binding benchmark from a checkout rather than the bench extra: its src/ directory on PYTHONPATH, after
# kotodama's own (the checkout root also holds tools/ and tests/, which must not shadow kotodama's), and the koto:
# loader named for it (kotodama.bench_plugin).
# export PYTHONPATH=${PYTHONPATH:+$PYTHONPATH:}/data/binding-bench/src
# export BINDING_BENCH_LOADERS=koto=kotodama.bench_plugin:load_koto

# Hugging Face cache (tokenizer + public checkpoints).
# export HF_HOME=/data/huggingface

# Hugging Face token file (huggingface_hub reads it), instead of HF_TOKEN on a command line.
# export HF_TOKEN_PATH=/path/to/hf_token
# Turn off Xet transfers where they stall.
# export HF_HUB_DISABLE_XET=1

# Signing (kotodama.serve.sign): where a signing server keeps its sign spool (records and signed batches; on the
# machine's own data disk, ~20 KB per signed row), and the SignatureReducer it signs with (package.module:attr) and
# its JSON keyword arguments, where its package lives, and the fleet's canonical kernel pin table (replayed by every
# replica, so their rows are one lane). A serve profile that signs every request (sign_default) needs them all.
# export KOTODAMA_SIGN_SPOOL=/data/kotodama/sign-spool
# export KOTODAMA_SIGN_REDUCER=package.module:Reducer
# export KOTODAMA_SIGN_REDUCER_KWARGS='{"device": "cuda:0"}'
# export KOTODAMA_SIGN_PYTHONPATH=/path/to/the/reducer/package/root
# export KOTODAMA_KERNEL_PINS=/path/to/the/fleets/canonical/pins.json
